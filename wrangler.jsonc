{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Built by Cloudflare Workers Builds (Git integration) on every push to main:
	// build command `pnpm cf:build`, deploy command `npx wrangler deploy`.
	// No GitHub Actions workflow is involved — see docs/cloudflare.md.
	// Never build+upload from a laptop.
	"main": ".open-next/worker.js",
	"name": "zenmux-arena",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "zenmux-arena"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	// Runtime variables/secrets are managed in the Cloudflare dashboard
	// (or `wrangler secret put`). keep_vars stops CI deploys from wiping them.
	"keep_vars": true,
	"observability": {
		"enabled": true
	}
}
