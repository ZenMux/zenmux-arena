# Public application runtime: snapshot reads only. Also used by the internal task.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # Legacy alternative
# ARENA_CACHE_TIMEOUT_MS=15000

# pnpm dev/build/start and maintenance commands automatically enable NODE_USE_ENV_PROXY.
# Optional proxy addresses; keep actual values in the host environment or .env.local.
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=localhost,127.0.0.1

# Public-key isolation checks (not required for normal page requests).
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional research pipeline credentials; never required by billing dashboards.
ZENMUX_API_KEY=

# Optional schema setup / transactional database checks only.
SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_URL=

# Internal refresh task only: required for the default `pnpm data:refresh` run.
# Fill these on the internal host; never provision them to Vercel/Morphe.
# The task also uses SUPABASE_URL and SUPABASE_SECRET_KEY above.
BILLING_DB_HOST=
BILLING_DB_PORT=3306
BILLING_DB_USER=
BILLING_DB_PASSWORD=
BILLING_DB_DATABASE=
ZENMUX_MANAGEMENT_API_KEY=

# Optional internal task overrides. Query timeouts default to 300000 in data:refresh.
# BILLING_ECON_QUERY_TIMEOUT_MS=300000
# BILLING_DEALS_QUERY_TIMEOUT_MS=300000
# TOKEN_ECON_LIVE_START_ISO=2026-06-23T06:00:00.000Z
# TOKEN_DEALS_START_ISO=2025-09-29T00:00:00.000Z
# TOKEN_ECON_LIVE_BUCKET_SECONDS=300
# TOKEN_ECON_LIVE_REFRESH_INTERVAL_SECONDS=300
# TOKEN_DEALS_CONFIG_PATH=config/token-deals.json

# Optional Economics connection-pool limits; Deals uses its own fixed pool limits.
# BILLING_DB_POOL_SIZE=8
# BILLING_DB_QUEUE_LIMIT=32
# BILLING_DB_MAX_IDLE=4
# BILLING_DB_IDLE_TIMEOUT_MS=60000

# A task-only template is also available in internal/data-refresh/.env.example.
