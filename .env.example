# Study pipeline API key. Required for `pnpm study:*` commands.
ZENMUX_API_KEY=sk-your-zenmux-api-key

# Optional: enables Token Economics launch-window usage backfill.
ZENMUX_MANAGEMENT_KEY=your-zenmux-management-key

# Token Economics Live database connection.
TOKEN_ECON_LIVE_DB_HOST=your-db-host
TOKEN_ECON_LIVE_DB_PORT=3306
TOKEN_ECON_LIVE_DB_USER=your-db-user
TOKEN_ECON_LIVE_DB_PASSWORD=your-db-password
TOKEN_ECON_LIVE_DB_DATABASE=your-db-name

# Token Economics Live window start. ISO date/time; UTC is recommended.
# If omitted, the app falls back to 2026-06-22T00:00:00.000Z.
TOKEN_ECON_LIVE_START_ISO=2026-06-22T00:00:00.000Z

# Token Economics Live aggregation and refresh cadence, in seconds.
# Defaults are both 300, so each 5-minute refresh shows the previous full
# 5-minute bucket (for example, 00:05 shows data from 00:00-00:05).
TOKEN_ECON_LIVE_BUCKET_SECONDS=300
TOKEN_ECON_LIVE_REFRESH_INTERVAL_SECONDS=300
