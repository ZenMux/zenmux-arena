# Public application runtime: snapshot reads only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # Legacy alternative
# ARENA_CACHE_TIMEOUT_MS=15000

# pnpm dev/build/start and maintenance commands automatically enable NODE_USE_ENV_PROXY.
# Optional proxy addresses; keep actual values in the host environment or .env.local.
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=localhost,127.0.0.1

# Public-key isolation checks (not required for normal page requests).
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional research pipeline credentials; never required by billing dashboards.
ZENMUX_API_KEY=

# Optional schema setup / transactional database checks only.
SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_URL=

# Internal refresh task configuration is documented separately in
# internal/data-refresh/.env.example. Never provision source DB credentials
# or the management API key to the public application.
