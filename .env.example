# ZenMux Arena — local configuration template (never put real credentials here).
# Copy to .env.local and edit that file; no ~/.zshrc exports are needed.
# Standard precedence: existing process/shell/CI env wins; .env.local fills gaps.
# An absent .env.local preserves CI/deployment-injected environment variables.
# Production Workers/Morphe use runtime Secrets/env, NOT an uploaded .env.local.

# --- Model API access ---
# Generation key: Who Are You? and personality ask/extract commands only.
# Neither the web viewer nor a build needs this key.
ZENMUX_API_KEY=
# Management key: REQUIRED for Economics daily-use/Value Ladder/Value Map data.
# This is not a generation key; local and deployed environments use this exact name.
ZENMUX_MANAGEMENT_API_KEY=

# --- Live billing origin (read-only account; shared by Economics and Deals) ---
TOKEN_ECON_LIVE_DB_HOST=
TOKEN_ECON_LIVE_DB_PORT=3306
TOKEN_ECON_LIVE_DB_USER=
TOKEN_ECON_LIVE_DB_PASSWORD=
TOKEN_ECON_LIVE_DB_DATABASE=

# --- Supabase shared snapshots (server-only) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Publishable key is only needed by supabase:check/test to verify role isolation.
SUPABASE_PUBLISHABLE_KEY=
# Legacy alternatives; prefer the canonical server names above.
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put a secret/service-role key in any NEXT_PUBLIC_* variable.

# --- Live coverage and cadence ---
# Shared start: Deals clamps deal periods/free ledgers to this UTC instant.
# If unset, Economics defaults to 2026-06-22; Deals to 2026-06-23T06:00:00Z.
TOKEN_ECON_LIVE_START_ISO=2026-06-23T06:00:00.000Z
TOKEN_ECON_LIVE_BUCKET_SECONDS=300
TOKEN_ECON_LIVE_REFRESH_INTERVAL_SECONDS=300
# Optional Deals-only start; otherwise uses TOKEN_ECON_LIVE_START_ISO.
# TOKEN_DEALS_START_ISO=
# TOKEN_DEALS_CONFIG_PATH=config/token-deals.json

# --- Optional query/cache tuning (shown values are the runtime defaults) ---
# TOKEN_ECON_LIVE_QUERY_TIMEOUT_MS=60000
# TOKEN_DEALS_QUERY_TIMEOUT_MS=120000
# TOKEN_ECON_LIVE_DB_POOL_SIZE=8
# TOKEN_ECON_LIVE_DB_QUEUE_LIMIT=32
# TOKEN_ECON_LIVE_DB_MAX_IDLE=4
# TOKEN_ECON_LIVE_DB_IDLE_TIMEOUT_MS=60000
# ARENA_CACHE_TIMEOUT_MS=15000
# Deals maintenance refresh/backfill default to a longer 300000ms query timeout.

# --- Supabase administration only (never deploy these credentials) ---
# Choose one only when applying/testing schema; neither is needed by web runtime.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_URL=

# --- Optional local tooling ---
# Wrangler account/API authorization, not an application runtime secret.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# WORKER_SMOKE_URL=http://localhost:4173
# PAPER_LANG=zh
# Build metadata (SOURCE_COMMIT, VERCEL_GIT_COMMIT_SHA, GITHUB_SHA,
# NEXT_PUBLIC_APP_VERSION/GIT_SHA/BUILD_TIME) is generated/injected; do not copy
# these into .env.local. ARENA_WORKERS_BUILD is set by vite.config.ts itself.
