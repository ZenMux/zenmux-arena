# Study pipeline API key. Required for `pnpm study:*` commands.
ZENMUX_API_KEY=sk-your-zenmux-api-key

# Optional: enables Token Economics launch-window usage backfill.
ZENMUX_MANAGEMENT_KEY=your-zenmux-management-key

# Live billing database connection — shared by Token Economics (live
# leaderboard) and Token Deals（让利账本：valid_usage 用量/金额 +
# model_discount 折扣期次 + model 模型信息，含 -free 免费模型）.
TOKEN_ECON_LIVE_DB_HOST=your-db-host
TOKEN_ECON_LIVE_DB_PORT=3306
TOKEN_ECON_LIVE_DB_USER=your-db-user
TOKEN_ECON_LIVE_DB_PASSWORD=your-db-password
TOKEN_ECON_LIVE_DB_DATABASE=your-db-name

# Live window start, shared by Token Economics AND Token Deals. ISO date/time;
# UTC is recommended. Token Deals clamps every deal window and free-model
# ledger to this instant (discount rows fully reverted before it never
# surface). If omitted: token-economics falls back to 2026-06-22T00:00:00.000Z,
# token-deals to 2026-06-23T06:00:00.000Z — set it explicitly.
TOKEN_ECON_LIVE_START_ISO=2026-06-23T06:00:00.000Z

# Token Economics Live aggregation and refresh cadence, in seconds.
# Defaults are both 300, so each 5-minute refresh shows the previous full
# 5-minute bucket (for example, 00:05 shows data from 00:00-00:05).
TOKEN_ECON_LIVE_BUCKET_SECONDS=300
TOKEN_ECON_LIVE_REFRESH_INTERVAL_SECONDS=300

# Optional: Token Economics Live database connection pool tuning.
# All have safe defaults and only need adjustment for high-traffic deployments.
# TOKEN_ECON_LIVE_DB_POOL_SIZE=8         # Max active DB connections (shared across all users)
# TOKEN_ECON_LIVE_DB_QUEUE_LIMIT=32      # Max queued requests when all connections are busy
# TOKEN_ECON_LIVE_DB_MAX_IDLE=4          # Max idle connections kept open for reuse
# TOKEN_ECON_LIVE_DB_IDLE_TIMEOUT_MS=60000  # Close idle connections after this many ms

# Optional: Performance tuning for live queries.
# Note: the in-memory cache TTL is no longer a fixed number — it auto-extends to
# the next refresh boundary (the window over which the answer cannot change), so
# a hot range is served from memory with zero DB load until a new bucket closes.
# TOKEN_ECON_LIVE_QUERY_TIMEOUT_MS=60000 # Single query timeout (ms)
