{
  "name": "zenmux-arena",
  "version": "0.65.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "study:run": "tsx research/scripts/run.ts",
    "study:extract": "tsx research/scripts/extract.ts",
    "study:mix": "tsx research/scripts/mix.ts",
    "study:aggregate": "tsx research/scripts/aggregate.ts",
    "study:report": "tsx research/scripts/report.ts",
    "study:test": "tsx research/scripts/run.ts && tsx research/scripts/extract.ts && tsx research/scripts/aggregate.ts",
    "personality:run": "tsx research/personality/run.ts",
    "personality:aggregate": "tsx research/personality/aggregate.ts",
    "personality:models:check": "tsx research/personality/check-models.ts",
    "personality:test": "tsx --test research/personality/*.test.ts",
    "personality:score:test": "tsx --test research/personality/score.test.ts",
    "tokenecon": "tsx research/scripts/tokenecon.ts",
    "tokenecon:refresh": "tsx research/scripts/refresh-live.ts",
    "tokendeals:refresh": "tsx research/scripts/refresh-deals.ts",
    "tokendeals:sync": "tsx research/scripts/sync-deals-config.ts",
    "tokendeals:backfill": "tsx research/scripts/backfill-deals.ts",
    "supabase:setup": "tsx scripts/supabase-setup.ts",
    "supabase:check": "tsx scripts/supabase-setup.ts --check",
    "supabase:sql": "tsx scripts/supabase-setup.ts --print",
    "cache:test": "tsx --test research/cache/*.test.ts",
    "supabase:test": "tsx scripts/supabase-setup.ts --test",
    "dev:vinext": "pnpm cf:dev",
    "build:vinext": "pnpm cf:build",
    "start:vinext": "pnpm cf:preview",
    "deploy:vinext": "pnpm cf:deploy",
    "cf:prepare": "tsx scripts/prepare-worker-content.ts",
    "cf:check": "vinext check",
    "cf:build": "pnpm cf:prepare && vite build",
    "cf:dev": "pnpm cf:prepare && vite dev --host localhost --port 3001",
    "cf:preview": "vite preview --host localhost --port 3001",
    "cf:deploy": "pnpm cf:build && vinext-cloudflare deploy --skip-build",
    "cf:dry-run": "pnpm cf:deploy:check && pnpm cf:build && wrangler deploy --dry-run",
    "cf:test": "pnpm cf:prepare && tsx --test worker/*.test.ts",
    "cf:smoke": "node scripts/smoke-worker.mjs",
    "cf:ci": "pnpm cf:check && pnpm cf:deploy:check && pnpm lint && pnpm typecheck && pnpm cache:test && pnpm personality:test && pnpm cf:test && pnpm cf:build",
    "typecheck": "next typegen && tsc --noEmit",
    "cf:deploy:check": "vinext-cloudflare deploy --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.116.0",
    "@zenmux/icons": "0.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.2.1",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.7",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.22.5",
    "next": "16.2.6",
    "openai": "^7.13.0",
    "p-limit": "^7.3.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.10.2",
    "yaml": "^2.9.0",
    "vinext": "1.3.0",
    "react-server-dom-webpack": "19.3.1",
    "@vinext/cloudflare": "1.2.0",
    "@resvg/resvg-wasm": "2.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "@cloudflare/vite-plugin": "1.65.0",
    "wrangler": "4.152.0",
    "vite-css-modules": "1.16.0",
    "postcss": "8.5.31"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=12.11.2"
  }
}
