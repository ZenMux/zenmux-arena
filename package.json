{
  "name": "zenmux-arena",
  "version": "0.65.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/with-env-proxy.mjs next dev",
    "build": "node scripts/with-env-proxy.mjs next build",
    "start": "node scripts/with-env-proxy.mjs next start",
    "lint": "eslint",
    "study:run": "node scripts/with-env-proxy.mjs tsx research/scripts/run.ts",
    "study:extract": "node scripts/with-env-proxy.mjs tsx research/scripts/extract.ts",
    "study:mix": "node scripts/with-env-proxy.mjs tsx research/scripts/mix.ts",
    "study:aggregate": "node scripts/with-env-proxy.mjs tsx research/scripts/aggregate.ts",
    "study:report": "node scripts/with-env-proxy.mjs tsx research/scripts/report.ts",
    "study:test": "node scripts/with-env-proxy.mjs tsx research/scripts/run.ts && node scripts/with-env-proxy.mjs tsx research/scripts/extract.ts && node scripts/with-env-proxy.mjs tsx research/scripts/aggregate.ts",
    "personality:run": "node scripts/with-env-proxy.mjs tsx research/personality/run.ts",
    "personality:aggregate": "node scripts/with-env-proxy.mjs tsx research/personality/aggregate.ts",
    "personality:models:check": "node scripts/with-env-proxy.mjs tsx research/personality/check-models.ts",
    "personality:test": "node scripts/with-env-proxy.mjs tsx --test research/personality/*.test.ts",
    "personality:score:test": "node scripts/with-env-proxy.mjs tsx --test research/personality/score.test.ts",
    "tokenecon": "node scripts/with-env-proxy.mjs tsx research/scripts/tokenecon.ts",
    "tokenecon:refresh": "node scripts/with-env-proxy.mjs tsx internal/data-refresh/refresh-economics.ts",
    "tokendeals:refresh": "node scripts/with-env-proxy.mjs tsx internal/data-refresh/refresh-deals.ts",
    "tokendeals:sync": "node scripts/with-env-proxy.mjs tsx internal/data-refresh/sync-deals-config.ts",
    "tokendeals:backfill": "node scripts/with-env-proxy.mjs tsx internal/data-refresh/backfill-deals.ts",
    "supabase:setup": "node scripts/with-env-proxy.mjs tsx scripts/supabase-setup.ts",
    "supabase:check": "node scripts/with-env-proxy.mjs tsx scripts/supabase-setup.ts --check",
    "supabase:sql": "node scripts/with-env-proxy.mjs tsx scripts/supabase-setup.ts --print",
    "cache:test": "node scripts/with-env-proxy.mjs tsx --test research/cache/*.test.ts",
    "supabase:test": "node scripts/with-env-proxy.mjs tsx scripts/supabase-setup.ts --test",
    "data:refresh": "node scripts/with-env-proxy.mjs tsx --env-file=.env.local internal/data-refresh/main.ts",
    "data:refresh:build": "node internal/data-refresh/build.mjs",
    "data:refresh:test": "node scripts/with-env-proxy.mjs tsx --test internal/data-refresh/*.test.ts",
    "deploy:verify": "node scripts/verify-public-build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.116.0",
    "@zenmux/icons": "0.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.2.1",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.7",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "openai": "^7.13.0",
    "p-limit": "^7.3.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.10.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "mysql2": "^3.22.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
